# copy to mesh.env and fill in your postgres DSN. mesh.env is gitignored
# (it holds the db password). put the SAME mesh.env on every node (mac, dell,
# the vps boxes): they all join the one shared frontier and never double-crawl.
#
# then on any node just run:  ./run.sh
#
# DSN host is the mac's tailscale ip; port 5433 per the setup guide.
CRAWLER_DB="postgresql+asyncpg://crawler:YOURPASSWORD@100.87.45.88:5433/crawler"
CRAWLER_KEEP_ALIVE=true
CRAWLER_BASE_DIR="$HOME/crawlerdata"
